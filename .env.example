# Zkopíruj jako .env (lokálně) nebo nastav jako proměnné v Railway.
# SECRET_KEY vygeneruješ: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Heslo admina — buď hash (python3 set_password.py), nebo pro rychlý start plaintext:
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=
# V produkci (Railway) nastav:
# FLASK_ENV=production
# BLOG_DATA_DIR=/data   (mount Railway volume na /data, jinak se články ztratí při redeployi)
